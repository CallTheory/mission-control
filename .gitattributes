# Text files - convert to CRLF on checkout and LF on commit
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.blade.php text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.env text eol=lf
.env text eol=lf
.env.example text eol=lf
sail text eol=lf
vendor/bin/sail text eol=lf

# Container build files. These are consumed by Linux shells inside the image,
# so a CRLF checkout breaks them -- the "bash\r: No such file or directory"
# failure in CLAUDE.md. Dockerfile has no extension, so none of the rules
# above covered it and it silently went CRLF.
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.dockerfile text eol=lf
docker/** text eol=lf
.dockerignore text eol=lf
docker-compose.yml text eol=lf

# Binary files - don't modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.rar binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Vendor files
*.css linguist-vendored
*.scss linguist-vendored
*.js linguist-vendored

# Export ignore
CHANGELOG.md export-ignore
