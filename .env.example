APP_NAME="Mission Control"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_HOST=localhost
APP_URL="http://${APP_HOST}"
APP_SERVICE=mission-control.test

BOARD_CHECK_STARTING_CALLID=335428

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mission_control
DB_USERNAME=mission_control
DB_PASSWORD=s3cret!

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_WS_HOST="${APP_HOST}"
PUSHER_WS_PORT=443
PUSHER_WS_PATH="ws"

VITE_PUSHER_WS_HOST="${PUSHER_WS_HOST}"
VITE_PUSHER_WS_PORT="${PUSHER_WS_PORT}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"

TELESCOPE_ENABLED=false

RING_CENTRAL_ACTIVE=0
RING_CENTRAL_CLIENT_ID=
RING_CENTRAL_CLIENT_SECRET=
RING_CENTRAL_JWT_TOKEN=
RING_CENTRAL_API_ENDPOINT=https://platform.ringcentral.com

# Used for stripe/fillout form redirect
STRIPE_KEY=your-stripe-key
STRIPE_SECRET=your-stripe-secret
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Twilio API credentials for WCTP to SMS forwarding
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


#WHISPER_MODEL="ggml-base-q5_0.bin"
#WHISPER_MODEL="ggml-base-q5_0.bin"
WHISPER_COMMAND_PARAMS="--translate"

APP_UNC_PATH="\\\\mission-control\\"

INBOUND_EMAIL_DAYS_TO_KEEP=30

# Shared secrets for unauthenticated inbound webhooks. Set each to a long random
# value (e.g. `php -r "echo bin2hex(random_bytes(32));"`). When unset the matching
# endpoint rejects all requests.
INBOUND_EMAIL_FORWARD_SECRET=
INBOUND_EMAIL_PARSE_SECRET=
FAX_WEBHOOK_SECRET=

# SAML2 hardening (optional). Restrict which email domains may auto-provision via
# SAML (comma-separated; empty = allow any domain the IdP asserts), and optionally
# require the assertion to carry an AudienceRestriction naming this SP.
SAML2_ALLOWED_EMAIL_DOMAINS=
SAML2_REQUIRE_AUDIENCE=false

# Recording/screen-capture access: when a team has no allowed_accounts/allowed_billing
# configured, deny recording/screen-capture access by default. Set true only to allow
# such "unrestricted" teams to pull any call's media.
RECORDINGS_ALLOW_UNRESTRICTED_TEAMS=false

# Infinity+IS user?
#APP_SWITCH_ENGINE=infinity

# ---------------------------------------------------------------------------
# Observability — exception reporting to GlitchTip/Sentry.
#
# OFF by default. Normally configured by an administrator at
# System -> Observability, which stores the values (DSN encrypted) in the
# database. The variables below are FALLBACKS AND OVERRIDES: when explicitly
# set they WIN over the database, so they act as a kill switch that works
# without database access, and let CI/staging force a setting.
#
# Leave them unset to let the admin UI control this.
# ---------------------------------------------------------------------------
#OBSERVABILITY_ERRORS_ENABLED=false
#OBSERVABILITY_ERRORS_DSN=
#OBSERVABILITY_ENVIRONMENT=
#OBSERVABILITY_RELEASE=
#OBSERVABILITY_ERRORS_SAMPLE_RATE=1.0

# Attaches client IP, cookies and unfiltered auth headers to every event.
# This application handles call-center data — leave this false.
#OBSERVABILITY_SEND_DEFAULT_PII=false

# ---------------------------------------------------------------------------
# Observability — OpenTelemetry tracing to Grafana Tempo.
#
# OFF by default. Normally configured at System -> Observability; as with error
# reporting, these variables OVERRIDE the database when explicitly set.
#
# Point the endpoint at a collector on this host — normally a Grafana Alloy
# agent with an otelcol.receiver.otlp block, which forwards to Tempo. Alloy is
# the operator's own infrastructure and is NOT assumed to be running: the admin
# page has a "Check collector" button that reports when nothing is listening.
# ---------------------------------------------------------------------------
#OBSERVABILITY_TRACING_ENABLED=false
#OBSERVABILITY_TRACING_ENDPOINT=http://localhost:4318
#OBSERVABILITY_TRACING_PROTOCOL=http/protobuf
#OBSERVABILITY_TRACING_SAMPLE_RATE=0.1

# Grafana Cloud: username is the instance ID, token is the API key.
#OBSERVABILITY_TRACING_AUTH_USERNAME=
#OBSERVABILITY_TRACING_AUTH_TOKEN=

# Deep-link template used to correlate a GlitchTip issue with its Tempo trace.
#OBSERVABILITY_TRACE_UI_URL="https://grafana.example.com/explore?traceId=%s"
